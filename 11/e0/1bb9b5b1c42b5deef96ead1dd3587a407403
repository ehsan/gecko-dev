<!DOCTYPE html>
<html>
<body onload="init()">
    <textarea spellcheck="true">blahblahblah</textarea>
    <script>
      function init() {
        document.querySelector("textarea").setAttribute("spellcheck", "false");
      }
    </script>
</body>
</html>
