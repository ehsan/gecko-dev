  <body>
    <div class="flexbox">
      <div>text</div>
    </div>

    <div class="flexbox">
      <div>text</div>
    </div>

    <div class="flexbox">
      <div>text</div>
    </div>

    <div class="flexbox" style="height: 30px">
      <div>text</div>
    </div>

    <div class="flexbox" style="height: 6px">
      <div>text</div>
    </div>

    <div class="flexbox" style="height: 30px">
      <div>text</div>
    </div>

