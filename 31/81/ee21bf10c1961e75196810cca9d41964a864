 </head>
 <body>
  <textarea cols=20 rows=4></textarea>
  <script>
    onload = function() {
      setTimeout(function() {
        document.querySelector("textarea").style.direction = "rtl";
        document.documentElement.removeAttribute("class");
      });
    };
  </script>
