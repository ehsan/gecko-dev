    {
      document.getElementById('i').type='tel';
    }
    function disableReftestWait()
    {
      document.documentElement.className = '';
    }
  </script>

  <body onload="setToTel(); disableReftestWait();">
    <input type='checkbox' id='i'>
  </body>
