<!DOCTYPE html>
<html>
  <body>
    <input value="foo">
    <script>
      var i = document.querySelector("input");
      i.selectionStart = 1;
      i.selectionEnd = 2;
      document.body.clientHeight;
      i.style.display = "none";
      document.body.clientHeight;
      i.style.display = "";
    </script>
  </body>
</html>
