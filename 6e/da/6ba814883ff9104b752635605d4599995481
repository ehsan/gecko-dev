<!DOCTYPE html>
<html>
<head>
  <meta charset=utf-8>
  <title>&lt;h6&gt;</title>
</head>
<body>
  <!-- is not strictly inline -->
  <p><dfn>text 
    <h6>more text</h6>
  </dfn></p>

  <!-- is not structured inline -->
  <p>text
    <h6>more text</h6>
  </p>

  <!-- cannot contain blocks -->
  <h6>
    <p>p1</p>
    <p>p2</p>
  </h6>

  <!-- cannot contain structured inline -->
  <h6>text
    <ul><li>text</li></ul>
  </h6>
</body>
</html>
