<!DOCTYPE html>
<html>
<body onload="init()">
    <input type="text" spellcheck="false" value="blahblahblah">
    <script>
      function init() {
        document.querySelector("input").setAttribute("spellcheck", "true");
      }
    </script>
</body>
</html>
