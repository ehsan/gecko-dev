function f(k) {
  function g(j) {
    return j + k;
  }
  return g;
}

g = f(10);
var ans = '';
for (var i = 0; i < 5; ++i) {
  ans += g(i) + ',';
}

assertEq(ans, '10,11,12,13,14,');

checkStats({
    recorderStarted: 1,
    recorderAborted: 0,
    traceTriggered: 1
});
