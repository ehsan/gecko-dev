# On OSF1 V5.0, pthreads is the default implementation strategy.
# Classic nspr is also available.

ifneq ($(OS_RELEASE),V3.2)
	USE_PTHREADS = 1
	ifeq ($(CLASSIC_NSPR), 1)
		USE_PTHREADS =
		IMPL_STRATEGY := _CLASSIC
	endif
endif

