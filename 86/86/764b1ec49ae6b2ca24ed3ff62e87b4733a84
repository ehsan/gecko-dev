/* Override default style */
select:invalid {
  box-shadow: none;
}

select.notvalid {
  background-color: green;
}
select.notvalid:-moz-ui-valid {
  background-color: red;
}

select.valid {
  background-color: red;
}
select.valid:-moz-ui-valid {
  background-color: green;
}
