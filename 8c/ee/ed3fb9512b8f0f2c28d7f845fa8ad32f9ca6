 </head>
 <body class="a">
  <div id="log"></div>
  <script>
   test(function() {
          var collection = document.getElementsByClassName("a");
          document.body.removeAttribute("class");
          assert_array_equals(collection, [document.documentElement]);
        })
  </script>
 </body>
