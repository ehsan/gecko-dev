# affixes only in compounds (see also fogemorpheme example)
ONLYINCOMPOUND O
COMPOUNDFLAG A
COMPOUNDPERMITFLAG P

SFX B Y 1
SFX B 0 s/OP .

# obligate fogemorpheme by forbidding the stem (0) in compounds

CHECKCOMPOUNDPATTERN 1
CHECKCOMPOUNDPATTERN 0/B /A
