load(libdir + "parallelarray-helpers.js");

function buildSimple() {
  // Simple constructor
  var a = [1,2,3,4,5];
  var p = new ParallelArray(a);
  assertEqParallelArrayArray(p, a);
  var a2 = a.slice();
  a[0] = 9;
  // No sharing
  assertEqParallelArrayArray(p, a2);
}

if (getBuildConfiguration().parallelJS)
  buildSimple();
