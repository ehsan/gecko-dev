function f(del) {
    o = arguments;
    if (del)
        delete o[2];
    for (var i = 0; i < HOTLOOP+2; ++i)
        assertEq(o[2] == undefined, del);
}

// record without arg deleted
f(false, 1,2,3,4);

// run with arg deleted
f(true, 1,2,3,4);
