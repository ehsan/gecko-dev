<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
</head>
<body>
<script>
function addPlugin(type="application/x-test") {
  var embed = document.createElement("embed");
  embed.style.width = "200px";
  embed.style.height = "200px";
  embed.setAttribute("type", type);
  return document.body.appendChild(embed);
}
</script>
</body>
