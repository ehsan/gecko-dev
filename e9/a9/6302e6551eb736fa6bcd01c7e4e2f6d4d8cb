// A debugger statement in a debuggerHandler should not reenter.

var g = newGlobal('new-compartment');
var calls = 0;

var dbg = Debugger(g);
dbg.onDebuggerStatement = function (stack) {
    calls++;
    debugger;
};

assertEq(g.eval("debugger; 7;"), 7);
assertEq(calls, 1);
