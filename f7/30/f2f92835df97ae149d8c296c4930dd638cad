<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style type="text/css">
div {
  margin:       10px;
  width:        10px;
  font-family:  monospace;
  -moz-hyphens: auto;
}
</style>
</head>
<!-- test some hyphenations that involve overlapping patterns -->
<body xml:lang="en-us">
<div>
photo
</div>
<div>
photograph
</div>
<div>
photographer
</div>
<div>
photographical
</div>
</body>
</html>
