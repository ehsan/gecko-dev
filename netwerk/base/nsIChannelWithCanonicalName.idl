#include "nsISupports.idl"

%{C++
#include "mozilla/MozPromise.h"

using CanonicalNamePromise = mozilla::MozPromise<nsCString, bool, false>;
%}

native CanonicalNamePromiseAddRefed(RefPtr<CanonicalNamePromise>);

/**
 * A channel that supports a canonical host name.
 */
[uuid(46a7e98b-626d-4a01-9a6a-9217396aaf91)]
interface nsIChannelWithCanonicalName : nsISupports
{
    /**
     * The canonical name of the host name from which the channel is being loaded.
     */
    [notxpcom] attribute ACString canonicalHostName;

    /**
     * Returns a promise which will be resolved when the canonical host name
     * has been resolved and is ready to be used.
     */
    [notxpcom]
    CanonicalNamePromiseAddRefed whenCanonicalHostNameAvailable();
};
